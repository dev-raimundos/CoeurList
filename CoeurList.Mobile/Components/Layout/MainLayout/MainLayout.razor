@inherits LayoutComponentBase
@inject ThemeService ThemeService

<MudThemeProvider @ref="_themeProvider" Theme="_themeManager.Theme" IsDarkMode="ThemeService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-shell">

    <div class="status-bar-safe-area"></div>

    <MudThemeManagerButton OnClick="@(() => OpenThemeManager(true))" />
    <MudThemeManager Open="_themeManagerOpen"
                     OpenChanged="OpenThemeManager"
                     Theme="_themeManager"
                     ThemeChanged="UpdateTheme"
                     IsDarkMode="ThemeService.IsDarkMode" />

    <div class="app-content">
        @Body
    </div>

    <NavMenu />
</div>

@code {
    private MudThemeProvider _themeProvider = null!;
    private ThemeManagerTheme _themeManager = new() { Theme = CoeurList.Theme.AppTheme.Theme };
    private bool _themeManagerOpen;

    protected override void OnInitialized()
    {
        ThemeService.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ThemeService.SetDarkMode(await _themeProvider.GetSystemDarkModeAsync());
        }
    }

    private void OpenThemeManager(bool open)
    {
        _themeManagerOpen = open;
    }

    private void UpdateTheme(ThemeManagerTheme theme)
    {
        _themeManager = theme;
    }

    public void Dispose()
    {
        ThemeService.OnChange -= StateHasChanged;
    }
}
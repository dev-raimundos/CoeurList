@inherits LayoutComponentBase
@inject ThemeService ThemeService
@implements IDisposable

<MudThemeProvider @ref="_themeProvider" Theme="AppTheme.Theme" IsDarkMode="ThemeService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-shell">

    <div class="status-bar-safe-area"></div>

    <div class="app-content">
        @Body
    </div>

    <NavMenu />
</div>

@code {
    private MudThemeProvider _themeProvider = null!;

    protected override void OnInitialized()
    {
        ThemeService.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ThemeService.SetDarkMode(await _themeProvider.GetSystemDarkModeAsync());
        }
    }

    public void Dispose()
    {
        ThemeService.OnChange -= StateHasChanged;
    }
}

@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor

<div class="component-wrapper">
    <nav class="bottom-nav">
        <MudNavLink Href="home" Match="NavLinkMatch.All" Class="bottom-nav-item">
            <div class="bottom-nav-item-content">
                <MudIcon Icon="@Icons.Material.Filled.Home" />
                <span class="bottom-nav-label">Home</span>
            </div>
        </MudNavLink>
        <MudNavLink Href="palette" Class="bottom-nav-item">
            <div class="bottom-nav-item-content">
                <MudIcon Icon="@Icons.Material.Filled.Palette" />
                <span class="bottom-nav-label">Paleta</span>
            </div>
        </MudNavLink>
        <MudNavLink Href="weather" Class="bottom-nav-item">
            <div class="bottom-nav-item-content">
                <MudIcon Icon="@Icons.Material.Filled.WbSunny" />
                <span class="bottom-nav-label">Clima</span>
            </div>
        </MudNavLink>
        <MudNavLink Href="profile" Class="bottom-nav-item">
            <div class="bottom-nav-item-content">
                <MudIcon Icon="@Icons.Material.Filled.Person" />
                <span class="bottom-nav-label">Perfil</span>
            </div>
        </MudNavLink>
    </nav>
</div>

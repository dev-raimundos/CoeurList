@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using CoeurMobile.App.Modules.Auth.Layouts

<div class="login-page">
    <MudPaper Class="login-card pa-8" Elevation="8">
        <div class="login-brand">
            <div class="login-brand-icon">
                <MudIcon Icon="@Icons.Material.Rounded.Favorite" Size="Size.Large" />
            </div>
            <MudText Typo="Typo.h4" Class="login-title">CoeurMobile</MudText>
            <MudText Typo="Typo.body2" Class="login-subtitle">Entre para continuar</MudText>
        </div>

        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="my-4" Dense="true">@_errorMessage</MudAlert>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Size="Size.Large"
                   Class="login-submit mt-6"
                   StartIcon="@Icons.Custom.Brands.Google"
                   Disabled="_isLoading"
                   OnClick="SubmitAsync">
            @if (_isLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Entrar com Google
        </MudButton>
    </MudPaper>
</div>

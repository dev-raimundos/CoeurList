@page "/palette"
@using MudBlazor

<MudText Typo="Typo.h4" Class="mb-2">Paleta de Cores</MudText>

<MudSwitch T="bool" Value="ThemeService.IsDarkMode" ValueChanged="ThemeService.SetDarkMode" Color="Color.Primary" Class="mb-6">
    Tema escuro
</MudSwitch>

<MudText Typo="Typo.subtitle1" Class="mb-2">Cores principais</MudText>
<MudGrid Spacing="3" Class="mb-6">
    @foreach (var swatch in MainSwatches)
    {
        <MudItem xs="6" sm="4">
            <MudPaper Elevation="2"
                      Class="pa-4 d-flex align-center justify-center"
                      Style="@($"height:96px;border-radius:12px;background-color:var({swatch.Bg});color:var({swatch.Text});")">
                <MudText Typo="Typo.subtitle2">@swatch.Name</MudText>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<MudText Typo="Typo.subtitle1" Class="mb-2">Tons (lighten / base / darken)</MudText>
@foreach (var row in ToneRows)
{
    <MudText Typo="Typo.body2" Class="mt-3 mb-1">@row.Label</MudText>
    <MudGrid Spacing="2">
        @foreach (var shade in row.Shades)
        {
            <MudItem xs="4" Class="d-flex flex-column align-center">
                <div style="@($"height:56px;width:100%;border-radius:8px;background-color:var({shade.ColorVar});")"></div>
                <MudText Typo="Typo.caption" Class="mt-1">@shade.Name</MudText>
            </MudItem>
        }
    </MudGrid>
}

<MudText Typo="Typo.subtitle1" Class="mt-6 mb-2">Superfícies</MudText>
<MudGrid Spacing="3">
    @foreach (var swatch in SurfaceSwatches)
    {
        <MudItem xs="6" sm="4">
            <MudPaper Outlined="true"
                      Class="pa-4 d-flex align-center justify-center"
                      Style="@($"height:96px;border-radius:12px;background-color:var({swatch.Bg});color:var({swatch.Text});")">
                <MudText Typo="Typo.subtitle2">@swatch.Name</MudText>
            </MudPaper>
        </MudItem>
    }
</MudGrid>
